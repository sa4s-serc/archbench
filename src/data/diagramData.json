{
  "title": "Architecture View Generation",
  "short_description": "Generate PlantUML architecture diagrams from repository summaries.",
  "long_description": "Given a natural-language summary of a software repository (components, dependencies, architectural styles), generate a PlantUML C4 architecture diagram that matches the ground-truth view. Submissions are evaluated using image similarity metrics (SSIM, PSNR, RMSE) comparing the rendered PNG of the generated diagram against the ground-truth diagram image. The dataset covers 339 open-source repositories spanning a variety of architectural styles, concerns, and notations. Approaches may use zero-shot, few-shot, guided planning (ArchView), or agentic strategies.",
  "paper_link": "https://arxiv.org/abs/2603.21178",
  "github_link": "https://github.com/sa4s-serc/archbench-diagram",
  "metrics": [
    {
      "name": "SSIM",
      "description": "Structural Similarity Index. Measures perceived visual similarity between generated and ground-truth diagram images. Higher is better. Primary metric; threshold >= 0.70."
    },
    {
      "name": "PSNR",
      "description": "Peak Signal-to-Noise Ratio. Measures image reconstruction quality in decibels. Higher is better."
    },
    {
      "name": "RMSE",
      "description": "Root Mean Square Error. Measures pixel-level difference between generated and ground-truth images. Lower is better."
    }
  ],
  "example_available": true,
  "dataset_download": true,
  "dataset_link": "https://github.com/sa4s-serc/ViewGeneration/tree/main/dataset",
  "type": "diagram",
