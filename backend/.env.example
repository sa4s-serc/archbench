# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection (use MongoDB Compass for visualization)
MONGODB_URI=mongodb://localhost:27017/archbench
# For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/archbench

# JWT configuration
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90